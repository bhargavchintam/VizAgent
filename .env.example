# Names only. On the workshop VM these are already exported from /config/<team>.config.
# In the deployed pod, deploy/deploy.sh injects VSS_* and WANDB_* from a Kubernetes Secret.
INGRESS_URL=<https://ingress-url>     # or VSS_URL
USERNAME=team-x                        # or VSS_USERNAME
PASSWORD=<password>                    # or VSS_PASSWORD
WANDB_API_KEY=<wandb-api-key>
WANDB_TEAM=<wandb-team>
WANDB_PROJECT=<wandb-project>
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
PORT=8080
